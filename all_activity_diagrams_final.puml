@startuml 09_Kelola_Data_Pelayan
title Admin — Kelola Data Pelayan

skinparam TitleFontStyle bold
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #1A5276
skinparam ActivityFontColor white
skinparam ActivityFontStyle bold
skinparam ActivityFontSize 13
skinparam ActivityBorderColor #154360
skinparam ActivityDiamondBackgroundColor #E74C3C
skinparam ActivityDiamondBorderColor #C0392B
skinparam ActivityDiamondFontColor white
skinparam ActivityDiamondFontStyle bold
skinparam SwimlaneHeaderBackgroundColor #0D1F2D
skinparam SwimlaneHeaderFontColor white
skinparam SwimlaneHeaderFontStyle bold
skinparam SwimlaneHeaderFontSize 13
skinparam SwimlaneBackgroundColor white
skinparam SwimlaneBorderColor #0D1F2D
skinparam ArrowColor #1A2A4A
skinparam DefaultFontName Arial

|Admin|
start
:Buka Manajemen Pelayan;

|Database|
:Sistem mengambil daftar\nseluruh pelayan gereja;

|Admin|
:Lihat Daftar Pelayan;

if (Ubah Status Aktif?) then (ya)
  :Tap Tombol Aktif / Nonaktif;
  |Database|
  :Sistem memperbarui\nstatus aktif pelayan;
  |Admin|
  :Tampilkan "Status\nBerhasil Diperbarui";

else (tidak — pilih aksi)
  if (Aksi yang dipilih?) then (Tambah)
    :Tap "Tambah Pelayan";
    :Isi Form\n(Nama, No. HP, Posisi,\nUser ID, Status Aktif);
    :Tap "Simpan";
    |Database|
    :Sistem menyimpan\ndata pelayan baru;
    |Admin|
    :Tampilkan "Pelayan\nBerhasil Ditambahkan";

  elseif (Edit?)
    :Tap Ikon Edit;
    :Ubah Data Pelayan;
    :Tap "Simpan";
    |Database|
    :Sistem memperbarui\ndata pelayan;
    |Admin|
    :Tampilkan "Data\nBerhasil Diperbarui";

  else (Hapus)
    :Tap Ikon Hapus;
    :Konfirmasi Dialog;
    |Database|
    :Sistem menghapus\ndata pelayan;
    |Admin|
    :Tampilkan "Pelayan\nBerhasil Dihapus";
  endif
endif

:Refresh Daftar Pelayan;
stop
@enduml

