@startuml 09_Admin_Kelola_Data_Pelayan
title Admin — Kelola Data Pelayan

<style>
swimlane {
  header {
    BackGroundColor #1E3A5F
    FontColor white
    FontStyle bold
    FontSize 13
  }
  BackGroundColor white
  BorderColor #1E3A5F
  LineColor #1E3A5F
}
</style>

skinparam TitleFontStyle bold
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #5B9BD5
skinparam ActivityFontColor white
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4A89C8
skinparam ActivityDiamondBackgroundColor #E74C3C
skinparam ActivityDiamondBorderColor #C0392B
skinparam ActivityDiamondFontColor white
skinparam ArrowColor #2E5D9A
skinparam DefaultFontName Arial

|Admin|
start
:Buka Manajemen Pelayan;

|Database|
:SELECT * FROM pelayans\nORDER BY nama;

|Admin|
:Lihat Daftar Pelayan;

if (Ubah Status Aktif?) then (ya)
  :Tap Tombol Aktif / Nonaktif;

  |Database|
  :UPDATE pelayans\nSET is_active = !is_active\nWHERE id = pelayanId;

  |Admin|
  :Tampilkan "Status Berhasil Diperbarui";

else (tidak — pilih aksi CRUD)

  if (Aksi yang dipilih?) then (Tambah)
    :Tap "Tambah Pelayan";
    :Isi Form (Nama, No. HP,\nPosisi, User ID, Status Aktif);
    :Tap "Simpan";

    |Database|
    :INSERT INTO pelayans\n(nama, phone, position,\nuser_id, is_active);

    |Admin|
    :Tampilkan "Pelayan Berhasil Ditambahkan";

  elseif (Edit?)
    :Tap Ikon Edit;
    :Ubah Data Pelayan;
    :Tap "Simpan";

    |Database|
    :UPDATE pelayans\nSET nama, phone, position\nWHERE id = pelayanId;

    |Admin|
    :Tampilkan "Data Berhasil Diperbarui";

  else (Hapus)
    :Tap Ikon Hapus;
    :Konfirmasi Dialog Penghapusan;

    |Database|
    :DELETE FROM pelayans\nWHERE id = pelayanId;

    |Admin|
    :Tampilkan "Pelayan Berhasil Dihapus";
  endif
endif

:Refresh Daftar Pelayan;
stop
@enduml

