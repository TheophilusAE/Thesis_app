@startuml 27_Admin_Tinjau_Permintaan_Penggantian
title Admin — Tinjau Permintaan Penggantian

<style>
swimlane {
  header {
    BackGroundColor #1E3A5F
    FontColor white
    FontStyle bold
    FontSize 13
  }
  BackGroundColor white
  BorderColor #1E3A5F
  LineColor #1E3A5F
}
</style>

skinparam TitleFontStyle bold
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #5B9BD5
skinparam ActivityFontColor white
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4A89C8
skinparam ActivityDiamondBackgroundColor #E74C3C
skinparam ActivityDiamondBorderColor #C0392B
skinparam ActivityDiamondFontColor white
skinparam ArrowColor #2E5D9A
skinparam DefaultFontName Arial

|Admin|
start
:Buka Permintaan Penggantian;

|Database|
:SELECT * FROM substitution_requests\nWHERE status = 'pending';

|Admin|
:Lihat Daftar Permintaan Pending;
:Pilih Permintaan;
:Baca Detail (Jadwal, Alasan,\nPengganti yang Diusulkan);

if (Keputusan Admin?) then (Setujui)
  :Tap "Setujui";

  |Database|
  :UPDATE substitution_requests\nSET status = 'approved',\nreviewed_by = adminId,\nreviewed_at = NOW();
  :UPDATE schedules\nSET pelayan_id = penggantiId\nWHERE id = scheduleId;
  :INSERT INTO notifications\n{user_id: pelayanId,\nmessage: 'Penggantian Disetujui',\nis_read: false};

  |Admin|
  :Tampilkan "Permintaan Disetujui";

else (Tolak)
  :Tulis Alasan Penolakan;
  :Tap "Tolak";

  |Database|
  :UPDATE substitution_requests\nSET status = 'rejected',\nadmin_notes = alasan;
  :INSERT INTO notifications\n{user_id: pelayanId,\nmessage: 'Penggantian Ditolak',\nis_read: false};

  |Admin|
  :Tampilkan "Permintaan Ditolak";
endif

:Refresh Daftar Permintaan;
stop
@enduml

