|Database|
:SELECT * FROM bible_verses\nWHERE type = 'devotional'\nAND date < TODAY\nORDER BY date DESC;

|Jemaat|
:Lihat Daftar Arsip Renungan\n(Judul, Referensi Ayat, Tanggal);

if (Pilih renungan dari arsip?) then (ya)
  :Pilih Renungan dari Arsip;

  |Aplikasi|
  :Load Detail Renungan dari Arsip;

  |Jemaat|
  :Baca Renungan dari Arsip;

else (tidak)
endif
stop
