skinparam DefaultFontName Arial

|Jemaat|
start
:Buka Renungan Harian;

|Database|
:SELECT * FROM bible_verses\nWHERE type = 'devotional'\nAND date = TODAY;

if (Renungan hari ini tersedia?) then (ya)

  |Aplikasi|
  :Load Detail Renungan;

  |Jemaat|
  :Baca Renungan Hari Ini\n(Ayat Referensi, Isi,\nRefleksi, Doa Penutup);

else (tidak)

  |Jemaat|
  :Tampilkan Pesan\n"Tidak ada renungan\nuntuk hari ini.";

