@startuml 13_Jemaat_Kirim_Feedback
title Jemaat — Kirim Feedback

<style>
swimlane {
  header {
    BackGroundColor #1E3A5F
    FontColor white
    FontStyle bold
    FontSize 13
  }
  BackGroundColor white
  BorderColor #1E3A5F
  LineColor #1E3A5F
}
</style>

skinparam TitleFontStyle bold
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #5B9BD5
skinparam ActivityFontColor white
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4A89C8
skinparam ActivityDiamondBackgroundColor #E74C3C
skinparam ActivityDiamondBorderColor #C0392B
skinparam ActivityDiamondFontColor white
skinparam ArrowColor #2E5D9A
skinparam DefaultFontName Arial

|Jemaat|
start
:Buka Menu Kirim Feedback;

|Aplikasi|
:Tampilkan Formulir Feedback;

|Jemaat|
:Pilih Jenis Feedback (Acara atau Umum);
:Tulis Pesan Feedback;
:Beri Penilaian Bintang (1—5);
:Aktifkan Opsi Anonim (opsional);
:Tap "Kirim";

|Aplikasi|
if (Pesan terisi dan\npenilaian lebih dari nol?) then (ya)

  |Database|
  :INSERT INTO feedback\n{user_id, type, message,\nrating, is_anonymous,\ncreated_at: NOW()};

  |Aplikasi|
  :Tampilkan "Feedback Berhasil Dikirim";
  :Kembali ke halaman sebelumnya;

else (tidak)

  |Jemaat|
  :Tampilkan Error\n"Pesan tidak boleh kosong";

endif
stop
@enduml

