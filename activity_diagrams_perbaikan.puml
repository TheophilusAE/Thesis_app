@startuml 28_Admin_Verifikasi_Pendaftaran
title Admin — Verifikasi Pendaftaran

<style>
swimlane {
  header {
    BackGroundColor #1E3A5F
    FontColor white
    FontStyle bold
    FontSize 13
  }
  BackGroundColor white
  BorderColor #1E3A5F
  LineColor #1E3A5F
}
</style>

skinparam TitleFontStyle bold
skinparam TitleFontSize 16
skinparam ActivityBackgroundColor #5B9BD5
skinparam ActivityFontColor white
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #4A89C8
skinparam ActivityDiamondBackgroundColor #E74C3C
skinparam ActivityDiamondBorderColor #C0392B
skinparam ActivityDiamondFontColor white
skinparam ArrowColor #2E5D9A
skinparam DefaultFontName Arial

|Admin|
start
:Buka Manajemen Pengguna;
:Filter: Tampilkan status "pending";

|Database|
:SELECT * FROM users\nWHERE membership_status = 'pending';

|Admin|
:Lihat Daftar Calon Anggota;
:Pilih Pengguna;
:Periksa Data Profil\n(Nama, NIK, Alamat, dll.);

if (Setujui keanggotaan?) then (ya)
  :Tap "Setujui";

  |Aplikasi|
  :Proses persetujuan keanggotaan;

  |Database|
  :UPDATE users\nSET membership_status = 'active'\nWHERE id = userId;
  :INSERT INTO notifications\n{user_id: userId,\nmessage: 'Akun Anda telah disetujui.',\nis_read: false};

  |Admin|
  :Tampilkan "Pengguna Berhasil Diverifikasi";

else (tidak)
  :Tap "Tolak";

  |Database|
  :UPDATE users\nSET membership_status = 'rejected'\nWHERE id = userId;

  |Admin|
  :Tampilkan "Pengguna Ditolak";
endif

:Refresh Daftar Pending;
stop
@enduml
