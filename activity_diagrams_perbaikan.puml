:Tap Tombol "Persembahan"\ndi Halaman Beranda;

|Aplikasi|
:Tampilkan Pilihan Metode Persembahan;

|Jemaat|
if (Metode yang dipilih?) then (QRIS)

  |Aplikasi|
  :Generate dan Tampilkan\nKode QR untuk Dipindai;

elseif (Transfer Bank?)

  |Database|
  :SELECT rekening_bank, nama_pemilik\nFROM church_accounts\nWHERE is_active = true;

  |Aplikasi|
  :Tampilkan Nomor Rekening\ndan Nama Pemilik Rekening;

else (Langsung)

  |Database|
  :SELECT * FROM service_schedules\nWHERE service_date >= TODAY\nORDER BY service_date ASC\nLIMIT 1;

  |Aplikasi|
  :Tampilkan Jadwal Ibadah Terdekat\nuntuk Membawa Persembahan Langsung;

endif

|Jemaat|
:Tutup Panel Persembahan;
:Kembali ke Halaman Beranda;
stop
